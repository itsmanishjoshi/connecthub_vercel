# Laptop / local: keep localhost (dev.mjs starts a private cluster on 5433).
DATABASE_URL=postgresql://connecthub_user:connecthub_office_local@localhost:5433/connecthub
# Office Postgres from DevOps (do not commit the real password):
# DATABASE_URL=postgresql://connecthub_user:YOUR_PASSWORD@172.52.10.57:5432/connecthub?sslmode=require
# Remote Postgres: add ?sslmode=require and URL-encode @ in the password as %40
# PGSSLMODE=require
PORT=8000
AUTH_SECRET=generate-a-long-random-string
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=choose-a-strong-initial-admin-password
ADMIN_EMAIL=admin@your-company.example

# --- AI providers (server only — never VITE_*) ---
# Primary: groq | openrouter | gemini | mistral | grok
AI_PROVIDER=groq
# Optional per-task override (falls back to AI_PROVIDER)
AI_CHAT_PROVIDER=
AI_LITE_PROVIDER=
AI_ANALYZE_PROVIDER=
AI_VISION_PROVIDER=
AI_EXTRACT_PROVIDER=

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LITE_MODEL=llama-3.3-70b-versatile
GROQ_ANALYZE_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_EXTRACT_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4
OPENROUTER_LITE_MODEL=openai/gpt-4o-mini
OPENROUTER_ANALYZE_MODEL=openai/gpt-4o-mini
OPENROUTER_EXTRACT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash
GEMINI_HEAVY_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=
GEMINI_ANALYZE_MODEL=
GEMINI_EXTRACT_MODEL=

# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_LARGE_MODEL=mistral-large-latest
MISTRAL_ANALYZE_MODEL=mistral-large-latest
MISTRAL_VISION_MODEL=pixtral-large-latest

# xAI Grok — https://console.x.ai
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-2-1212
GROK_API_BASE=https://api.x.ai/v1

# Optional web search (reserved)
TAVILY_API_KEY=

# Supabase Postgres example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Estimated analytics spend (USD per 1M tokens)
AI_INPUT_PRICE_PER_1M=2.50
AI_OUTPUT_PRICE_PER_1M=10.00
AI_LITE_INPUT_PRICE_PER_1M=0.15
AI_LITE_OUTPUT_PRICE_PER_1M=0.60

# Optional: server-side SharePoint upload token (never expose in the browser)
SHAREPOINT_ACCESS_TOKEN=

# Production/office: required. Comma-separated browser origins, e.g. https://connecthub.yourcompany.com
ALLOWED_ORIGINS=
# Set NODE_ENV=production in office/public deployments
NODE_ENV=development
# Use a long random AUTH_SECRET (32+ chars). Required for production and office serving.
# Never commit real secrets. Rotate if exposed.
# Optional local Postgres bootstrap when DATABASE_URL is not set (development only)
# DEV_POSTGRES_PASSWORD=
# DEV_POSTGRES_USER=connecthub_user
# DEV_POSTGRES_PORT=5433
# DEV_POSTGRES_DB=connecthub
OFFICE_PORT=8080
APP_URL=
UPLOAD_DIR=
# Set SERVE_STATIC=1 to serve frontend/dist on OFFICE_PORT (8080)
SERVE_STATIC=
