# Laptop / local: keep localhost (dev.mjs starts a private cluster on 5433).
DATABASE_URL=postgresql://connecthub_user:connecthub_office_local@localhost:5433/connecthub
# Office Postgres from DevOps (do not commit the real password):
# DATABASE_URL=postgresql://connecthub_user:YOUR_PASSWORD@172.52.10.57:5432/connecthub?sslmode=require
# Remote Postgres: add ?sslmode=require and URL-encode @ in the password as %40
# PGSSLMODE=require
PORT=8000
AUTH_SECRET=generate-a-long-random-string
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=choose-a-strong-initial-admin-password
ADMIN_EMAIL=admin@your-company.example

# --- AI (server only — never VITE_*) ---
# Azure OpenAI — https://portal.azure.com
AI_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_LITE_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EXTRACT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_ANALYZE_DEPLOYMENT=gpt-4o

# Optional web search (reserved)
TAVILY_API_KEY=

# Supabase Storage — large Excel ingest (photos) bypasses Vercel 4 MB upload limit
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: SUPABASE_INGEST_MAX_BYTES=104857600

# Supabase Postgres example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Estimated analytics spend (USD per 1M tokens)
AI_INPUT_PRICE_PER_1M=2.50
AI_OUTPUT_PRICE_PER_1M=10.00
AI_LITE_INPUT_PRICE_PER_1M=0.15
AI_LITE_OUTPUT_PRICE_PER_1M=0.60

# Optional: server-side SharePoint upload token (never expose in the browser)
SHAREPOINT_ACCESS_TOKEN=

# Production/office: required. Comma-separated browser origins, e.g. https://connecthub.yourcompany.com
ALLOWED_ORIGINS=
# Set NODE_ENV=production in office/public deployments
NODE_ENV=development
# Use a long random AUTH_SECRET (32+ chars). Required for production and office serving.
# Never commit real secrets. Rotate if exposed.
# Optional local Postgres bootstrap when DATABASE_URL is not set (development only)
# DEV_POSTGRES_PASSWORD=
# DEV_POSTGRES_USER=connecthub_user
# DEV_POSTGRES_PORT=5433
# DEV_POSTGRES_DB=connecthub
OFFICE_PORT=8080
APP_URL=
UPLOAD_DIR=
# Set SERVE_STATIC=1 to serve frontend/dist on OFFICE_PORT (8080)
SERVE_STATIC=
