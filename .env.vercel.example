# Vercel + Supabase — copy keys into Vercel project settings (never commit)

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

NODE_ENV=production
AUTH_SECRET=generate-a-long-random-string-32-chars-minimum
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_EMAIL=admin@connecthub.local
ALLOWED_ORIGINS=https://your-project.vercel.app

AI_PROVIDER=groq
AI_CHAT_PROVIDER=groq
AI_LITE_PROVIDER=groq
AI_ANALYZE_PROVIDER=groq
AI_VISION_PROVIDER=groq
AI_EXTRACT_PROVIDER=openrouter

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LITE_MODEL=llama-3.3-70b-versatile
GROQ_ANALYZE_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

OPENROUTER_API_KEY=
OPENROUTER_EXTRACT_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://your-project.vercel.app

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

UPLOAD_DIR=/tmp/connecthub-uploads
