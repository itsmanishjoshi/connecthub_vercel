# Copy to .env in this folder before: docker compose up --build
# Do not commit .env

OFFICE_PORT=8080
POSTGRES_PASSWORD=choose-a-strong-db-password

# If DevOps already provisioned Postgres, set DATABASE_URL and ignore POSTGRES_PASSWORD.
# Encode @ in the password as %40. Example host from office: 172.52.10.57
# DATABASE_URL=postgresql://connecthub_user:YOUR_PASSWORD@172.52.10.57:5432/connecthub?sslmode=require
# Then: docker compose up --build -d
# The bundled db container still starts unless you use: docker compose up --build -d --no-deps app
AUTH_SECRET=generate-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_EMAIL=admin@connecthub.local

AI_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROK_API_KEY=
ALLOWED_ORIGINS=
